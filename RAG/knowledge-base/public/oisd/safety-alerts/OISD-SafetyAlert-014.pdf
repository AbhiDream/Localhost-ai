</div>

<!--Start modal placeholder(pop up)-->
<div class="modal fade in" id='myModalOISD'>
    <div class="holder">
        <div id="divpopup" class="popup popupcontentTop">
            <div class="modal-header modal-header-new">
                <input type="button" class="btn btn-sm modal-input-btn" data-dismiss="modal" aria-hidden="true" value="x"/>
                <h4 class="modal-title" id="myModalHeaderOISD"></h4>
            </div>
            <div id='myModalContentOISD' class="popupui-body"></div>
            <div class="modal-header Model-header-Popup"></div>

        </div>
    </div>
</div>
<!--End modal placeholder-->
<!-- Modal confirm -->
<div class="modal Model-StyleClass" id="confirmModal">
    <div class="popup popupcontentTop">
        <div class="modal-content">
            <div class="modal-header" id="confirmMessage">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm" id="confirmOk">Ok</button>
                <button type="button" class="btn btn-sm" id="confirmCancel">Cancel</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal confirm -->
<script type="text/javascript">
        function ShowMessage(message, messagetype) {
            var cssclass;
            switch (messagetype) {
                case 'Success':
                    cssclass = 'alert-success'
                    break;
                case 'Error':
                    cssclass = 'alert-danger'
                    break;
                case 'Warning':
                    cssclass = 'alert-warning'
                    break;
                default:
                    cssclass = 'alert-info'
            }
            $('#alert_containerMainLayout').append('<div id="alert_div_topMessageLayout" style="margin: 0 0.5%; -webkit-box-shadow: 3px 4px 6px #999;" class="alert fade in ' + cssclass + '"><a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a><strong>' + messagetype + '!  </strong> <span>' + message + '</span></div>');

            setTimeout(function () {
                $("#alert_div_topMessageLayout").fadeTo(2000, 500).slideUp(500, function () {
                    $("#alert_div_topMessageLayout").remove();
                });
            }, 5000);
        }
        var options = { "backdrop": "static", keyboard: true };
        function ShowPopUpOISD(modaltitle, height, width, data) {
            $("#divpopup").width(width).height(height);
            $('#myModalHeaderOISD').html(modaltitle);
            $('#myModalContentOISD').html(data);
            $('#myModalOISD').modal(options);
            $('#myModalOISD').modal('show');
        }

        // Delete popup function
        function confirmDialog(message, onConfirm) {
            var modal = $("#confirmModal");
            var closeModal = function () {
                modal.modal("hide");
            };

            modal.modal(options);
            modal.modal("show");
            $("#confirmMessage").empty().append(message);

            // call funtion for delete data after clicking OK in alert popup
            $("#confirmOk").unbind('click').bind('click', onConfirm)
            $("#confirmOk").one('click', closeModal);

            // close popup after clicking cancel in alert popup
            $("#confirmCancel").one("click", closeModal);
        }
</script>

