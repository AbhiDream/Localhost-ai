    <script type="text/javascript">
        var selectedSize = '16px';

        function setFontSize(value) {

            var text = document.getElementById("text");

            if (!text) {
                console.log("Element #text not found");
                return;
            }

            text.style.fontSize = value;

            selectedSize = value;

            localStorage.setItem('fontSize', value);
        }


        function fontSize(selectTag) {

            setFontSize(selectTag);
        }


        function loadFont() {

            var storedSize = localStorage.getItem('fontSize');

            if (storedSize) {
                setFontSizeWithoutSave(storedSize);
            } else {
                setFontSizeWithoutSave("16px");
            }
        }


        function setFontSizeWithoutSave(value) {

            var text = document.getElementById("text");

            if (!text) return;

            text.style.fontSize = value;
            selectedSize = value;
        }


        function set_font_size(action) {

            var text = document.getElementById("text");

            if (!text) {
                return;
            }

            var currentSize = parseFloat(
                window.getComputedStyle(text).fontSize
            );

            var newSize = currentSize;


            if (action === "increase") {

                newSize = currentSize + 2;

                if (newSize > 24) {
                    newSize = 24;
                }
            }
            else if (action === "decrease") {

                newSize = currentSize - 2;

                if (newSize < 12) {
                    newSize = 12;
                }
            }
            else {

                newSize = 16;
            }


            setFontSize(newSize + "px");
        }


        $(document).ready(function () {

            loadFont();

        });
    </script>

